# Copy to .env and fill in. Never commit .env.

# Public hostname pointing at this server (Caddy gets a TLS certificate for it)
DOMAIN=wildlife.example.com

# Web login
ADMIN_USER=admin
# bcrypt hash of the password, kept in single quotes. Generate it with:
#   docker compose build && docker compose run --rm --no-deps --entrypoint hashpw server 'your password'
ADMIN_PASSWORD_HASH='$2a$10$replace-with-hashpw-output'

# Random secrets (at least 32 / 16 characters):  openssl rand -hex 32
JWT_SECRET=
DEVICE_KEY=

# Storage: old alerts, snapshots and clips are deleted automatically (0 = no limit)
# RETENTION_DAYS=14
# MAX_MEDIA_MB=2000

# Optional
# STREAM_FPS=8
# CLIP_PRE_SECONDS=3
# CLIP_POST_SECONDS=7
